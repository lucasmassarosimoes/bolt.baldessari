# Usar a imagem oficial do Node.js versão 20
FROM node:20.18.0

# Definir diretório de trabalho dentro do container
WORKDIR /app

# Instalar pnpm 9.1.2 e wrangler globalmente
RUN npm install -g pnpm@9.1.2 wrangler

# Copiar arquivos de dependência para o container
COPY package.json pnpm-lock.yaml ./

# Instalar dependências com logs detalhados
RUN pnpm install --reporter=ndjson --loglevel=debug

# Copiar todo o restante do código-fonte para o container
COPY . .

# Corrigir permissões e formato do script bindings.sh
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh

# Rodar o build da aplicação
RUN pnpm run build

# Expor a porta usada pela aplicação
EXPOSE 5173

# Definir variáveis de ambiente
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true

# Comando padrão para iniciar a aplicação
CMD ["pnpm", "run", "dockerstart"]
